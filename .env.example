# Postgres connection
DATABASE_URL="postgresql://schema:schema@localhost:5432/schema"
# Long random string shared by the web app and the realtime server (openssl rand -base64 32)
AUTH_SECRET="change-me"
# Public URL of the realtime WebSocket server, as the browser sees it
NEXT_PUBLIC_REALTIME_URL="ws://localhost:1234"
# Public URL of the web app (used in invite links)
APP_URL="http://localhost:3000"
REALTIME_PORT=1234

# Email (password resets, email confirmation, invites). Without SMTP_URL, emails are printed to the server log.
# SMTP_URL="smtps://user:password@smtp.example.com:465"
# EMAIL_FROM="Schema <no-reply@yourdomain.com>"

# Google sign-in: create an OAuth client (Web application) in Google Cloud Console with the
# redirect URI  <APP_URL>/api/auth/oidc/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Development only: skip the DNS TXT check when verifying workspace domains (ignored in production)
# DOMAIN_VERIFICATION="off"
