# Postgres connection
DATABASE_URL="postgresql://miroo:miroo@localhost:5432/miroo"
# Long random string shared by the web app and the realtime server (openssl rand -base64 32)
AUTH_SECRET="change-me"
# Public URL of the realtime WebSocket server, as the browser sees it
