{
  "name": "schema",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,rt -c blue,magenta \"next dev\" \"tsx watch server/realtime.ts\"",
    "dev:web": "next dev",
    "dev:realtime": "tsx watch server/realtime.ts",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:realtime": "tsx server/realtime.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cloudflare",
    "lint": "tsc --noEmit && tsc --noEmit -p cloudflare",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "cf:build": "prisma generate && opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && wrangler dev",
    "cf:deploy": "npm run cf:build && wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@opennextjs/cloudflare": "^1.20.17",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@tiptap/extension-collaboration": "^3.34.0",
    "@tiptap/extension-document": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/extension-task-item": "^3.34.0",
    "@tiptap/extension-task-list": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "bcryptjs": "^3.0.3",
    "gifuct-js": "^2.1.2",
    "jose": "^6.2.17",
    "jspdf": "^4.2.1",
    "konva": "^10.1.0",
    "lib0": "^0.2.120",
    "lucide-react": "^1.75.0",
    "nanoid": "^5.1.6",
    "next": "^16.4.6",
    "nodemailer": "^7.0.10",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2",
    "server-only": "^0.0.1",
    "ws": "^8.23.0",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^9.2.1",
    "dotenv": "^16.6.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.165.0"
  }
}
